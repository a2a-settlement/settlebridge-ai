{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://settlebridge.local/cyber/corpus.schema.json",
  "title": "SettleBridge Cyber evaluation corpus",
  "description": "Candidate PyPI fixes used to score challenge arms. Commit fields are 40 lowercase hex or null. verified stays false until the coordinator fills verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "commit": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha40"}
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project",
        "ecosystem",
        "advisory_ids",
        "category",
        "fix_commit",
        "base_commit",
        "followup_fix_commit",
        "failure_class",
        "property",
        "oracle_source",
        "notes",
        "held_out",
        "verified",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "description": "GitHub owner/name."
        },
        "ecosystem": {
          "const": "pypi"
        },
        "advisory_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(CVE-[0-9]{4}-[0-9]{4,}|GHSA-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4})$"
          }
        },
        "category": {
          "enum": ["incomplete_fix", "complete_fix", "regression"]
        },
        "fix_commit": {"$ref": "#/$defs/commit"},
        "base_commit": {"$ref": "#/$defs/commit"},
        "followup_fix_commit": {
          "$ref": "#/$defs/commit",
          "description": "Later commit that finished an incomplete fix, or null when that commit is unknown. Null for other categories."
        },
        "failure_class": {
          "enum": [
            "authorization_confidentiality",
            "integrity",
            "injection_execution",
            "denial_of_service",
            "regression"
          ]
        },
        "property": {
          "type": "string",
          "minLength": 20,
          "description": "One falsifiable sentence."
        },
        "oracle_source": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "held_out": {
          "type": "boolean",
          "description": "True means the entry must not be used to tune prompts."
        },
        "verified": {
          "type": "boolean",
          "description": "False until the coordinator records a check. Workers leave this false."
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {"enum": ["complete_fix", "regression"]}
            },
            "required": ["category"]
          },
          "then": {
            "properties": {
              "followup_fix_commit": {"type": "null"}
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_at", "checked_by", "evidence_urls"],
      "properties": {
        "checked_at": {"type": ["string", "null"]},
        "checked_by": {"type": ["string", "null"]},
        "evidence_urls": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
